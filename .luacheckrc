-- luacheck config for fenix-police. Run it through tools/lint.sh, which
-- generates the native lists this file loads (see below) and then lints.
--
-- The point of this file is to catch the bug classes that have actually bitten
-- this resource, mechanically, before anyone has to drive a car into them:
--
--   * reading a variable that doesn't exist (`playerPed` in GetVehicleUnstuck
--     was nil for years -- every unstick re-tasked units to chase entity 0)
--   * calling a native that doesn't exist on that side (`SetSirenKeepOn` in
--     server.lua is client-only; the server got "attempt to call a nil value")
--   * a global used before the file that defines it has loaded, or a missing
--     `local` silently clobbering another script's state (every script on one
--     side of a resource shares a single global table)

std = 'lua54'
max_line_length = false
codes = true

ignore = {
    '61.',  -- whitespace-only nits
    '212',  -- unused argument: event handlers and callbacks take fixed signatures
    '213',  -- unused loop variable: `for _, v in pairs` with a named `_`-less key
    '42.',  -- shadowing: `waitCount` and friends are deliberately re-declared per retry loop
    '43.',  -- shadowing an upvalue: same pattern, one level out
    '542',  -- empty if branch: several are intentional "nothing to do" arms with a comment
}

-- Native lists come from the @citizenfx/client and @citizenfx/server npm
-- typings, generated by tools/lint.sh into .luacheck/ (gitignored). Without
-- them every native reads as an undefined global, so refuse to run rather
-- than drown the real findings.
local function natives(side)
    local ok, list = pcall(dofile, '.luacheck/natives_' .. side .. '.lua')
    if not ok then
        error('missing .luacheck/natives_' .. side .. '.lua -- run tools/lint.sh, not luacheck directly')
    end
    return list
end

local clientNatives = natives('client')
local serverNatives = natives('server')

-- Natives available on both sides: the only ones shared/ files may call.
local sharedNatives = {}
do
    local onServer = {}
    for _, name in ipairs(serverNatives) do onServer[name] = true end
    for _, name in ipairs(clientNatives) do
        if onServer[name] then sharedNatives[#sharedNatives + 1] = name end
    end
end

-- The CitizenFX scheduler/runtime, plus the optional libraries this resource
-- feature-detects before touching (ox_lib's `lib`/`cache`, qb-core's object).
read_globals = {
    'Citizen', 'CreateThread', 'CreateThreadNow', 'Wait', 'SetTimeout',
    'RegisterNetEvent', 'RegisterServerEvent', 'AddEventHandler', 'RemoveEventHandler',
    'TriggerEvent', 'TriggerServerEvent', 'TriggerClientEvent',
    'TriggerLatentClientEvent', 'TriggerLatentServerEvent',
    'RegisterCommand', 'RegisterNUICallback', 'SendNUIMessage',
    'AddStateBagChangeHandler', 'RemoveStateBagChangeHandler',
    'GetCurrentResourceName', 'GetInvokingResource', 'IsDuplicityVersion',
    'exports', 'GlobalState', 'LocalPlayer', 'Player', 'Entity',
    'vector2', 'vector3', 'vector4', 'vec', 'vec2', 'vec3', 'vec4', 'quat',
    'json', 'msgpack', 'promise', 'Await', 'joaat', 'source',
    'GetPlayers', 'GetPlayerIdentifiers', 'GetPlayerTokens',
    'lib', 'cache', 'QBCore',
}

-- Globals this resource defines on purpose and reads from another file. Keep
-- this list exact: anything not on it that a file assigns at top level is a
-- missing `local`, and luacheck will say so.
globals = {
    'Config', 'FenixAmbientPoints',

    -- Module tables, one per file that defines them.
    'FenixFramework', 'FenixGuard', 'FenixIncident', 'FenixDispatch',
    'FenixUnitRegistry', 'FenixEMS', 'FenixFire', 'FenixInvestigate', 'FenixFSM',
    'FenixRoads', 'FenixLivery', 'FenixTracker', 'FenixPursuit', 'FenixTactics',
    'FenixBackup', 'FenixMorale', 'FenixJurisdiction',

    -- client/client.lua functions called from other client files.
    'ApplyWantedLevel', 'SetWantedLevel', 'IsVehicleStuck', 'MonitorVehicle',
    'GetVehicleUnstuck', 'GetPedsOutOfVehicle', 'PromoteAmbientUnit',
    'PromoteAmbientUnitForInvestigation', 'EffectiveSpawnWantedLevel',
    'ReleaseAllBreachShields', 'triggerArrest', 'IsCopPed',

    -- client/ambient.lua
    'ClaimNearbyPatrolForInvestigation',

    -- client/combat_bridge.lua
    'ApplyChaseTactics',

    -- server/server.lua
    'GetPlayersInRadius', 'GetWantedLevelFromCoords', 'round',

    -- um_fenix_bridge (its own resource, linted from here for convenience)
    'BridgeConfig', 'ERSState', 'Suppression',
}

files['client/'] = { read_globals = clientNatives }
files['um_fenix_bridge/client/'] = { read_globals = clientNatives }
files['server/'] = { read_globals = serverNatives }
files['um_fenix_bridge/server/'] = { read_globals = serverNatives }
files['shared/'] = { read_globals = sharedNatives }

-- Config files and data tables are evaluated on both sides and call no natives.
files['config.lua'] = { read_globals = sharedNatives }
files['config.local.example.lua'] = { read_globals = sharedNatives }
files['data/'] = { read_globals = sharedNatives }
files['um_fenix_bridge/config.lua'] = { read_globals = sharedNatives }

exclude_files = { 'fxmanifest.lua', 'um_fenix_bridge/fxmanifest.lua', '.luacheck/' }
