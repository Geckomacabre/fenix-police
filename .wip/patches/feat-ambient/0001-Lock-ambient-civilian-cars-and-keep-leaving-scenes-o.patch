From 7b4329ff6b278260dc64741ab498764c50a476ca Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 14 Oct 2026 17:55:25 +0000
Subject: [PATCH 1/2] Lock ambient civilian cars and keep leaving scenes out of
 promotion

- Every car an ambient scene creates is now locked against players, not
  just the cruisers: the pulled-over car, a pursuit suspect's abandoned car
  and a carjacked car were unlocked and client-local, so a player who took
  one drove a car nobody else could see. NPCs still get in and out as
  before; the lock moves into createVehicle and createCruiser goes away.
- The wanted sweep no longer tries to promote a patrol or convoy that is
  already driving off (releaseOnTeardown), such as a car that clocked the
  player, failed its own promotion and stood down. A second attempt would
  turn it round, and a failed one deleted it in plain view; it is now
  released to the population manager like any other departing scene.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01U5camWJeroZ7xuVfkwRiL2
---
 client/ambient.lua | 36 +++++++++++++++++++-----------------
 1 file changed, 19 insertions(+), 17 deletions(-)

diff --git a/client/ambient.lua b/client/ambient.lua
index a8ec94d..ec68939 100644
--- a/client/ambient.lua
+++ b/client/ambient.lua
@@ -304,6 +304,12 @@ local function createPed(modelName, x, y, z, heading, isCop)
     return ped
 end
 
+--- A car for a scene: a cruiser, or the civilian car that is pulled over,
+--- fleeing or carjacked. Every one is locked against players: everything here
+--- is client-local, so a player who drives off in one is sitting in a car
+--- nobody else can see, and the scene's own teardown would later delete it out
+--- from under them. Only players are locked out — officers, drivers, suspects
+--- (and an arrested one going into the back) still get in and out normally.
 local function createVehicle(modelName, x, y, z, heading)
     if type(modelName) ~= 'string' then return nil end
     local hash = GetHashKey(modelName)
@@ -316,23 +322,13 @@ local function createVehicle(modelName, x, y, z, heading)
     SetEntityAsMissionEntity(veh, true, true)
     SetVehicleOnGroundProperly(veh)
     SetVehicleHasBeenOwnedByPlayer(veh, false)
+    SetVehicleDoorsLockedForAllPlayers(veh, true)
     -- No-op on the civilian cars that also come through here -- only a model
     -- with livery mods (the add-on cruisers) is touched. See client/livery.lua.
     FenixLivery.apply(veh)
     return veh
 end
 
---- A police car for a scene. Locked against players: everything here is
---- client-local, so a player who drives off in an ambient cruiser is sitting
---- in a car nobody else can see, and the scene's own teardown would later
---- delete it out from under them. Only players are locked out — officers (and
