# Per-server config overrides. Anything in here is loaded after config.lua and
# never committed — server-specific model names, coordinates, job names and the
# like belong in this directory, not in the shipped config.
# See config.local.example.lua for the pattern.
config.local/

# Compiled Lua sources
luac.out

# luarocks build files
*.src.rock
*.zip
*.tar.gz

# Object files
*.o
*.os
*.ko
*.obj
*.elf

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo
*.def
*.exp

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

